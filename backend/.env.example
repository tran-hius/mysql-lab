# Cổng chạy API
PORT=4000

# Kết nối MySQL (MySQL 8.4 đang chạy sẵn trên máy)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mysql_lab

# User chỉ đọc cho database luyện tập shop
DB_READER_USER=lab_reader
DB_READER_PASSWORD=

# Số connection tối đa trong pool
DB_POOL_SIZE=10

# development | production
NODE_ENV=development
